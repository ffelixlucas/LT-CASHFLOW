# Copie para apps/web/.env.test — banco DEDICADO a E2E (nunca producao/Railway pessoal).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lt_cashflow_e2e

NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=e2e-nextauth-secret-change-me-32chars-min

# Obrigatorio se DB_NAME nao contiver "e2e" ou "test"
E2E_ALLOW_SEED=1

# Playwright (opcional)
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
