# Producao / dev local — copie para apps/web/.env.local (NAO commitar).
# Guia de lancamento familiar: docs/lancamento-controlado-familiar.md
# Deploy Railway: docs/deploy-railway.md
#
# Obrigatorias:
#   DB_* , NEXTAUTH_URL , NEXTAUTH_SECRET
# Opcionais (assistente / quick-add): GROQ_* ou OPENAI_*
# NUNCA em producao: E2E_ALLOW_SEED, apps/web/.env.test, pnpm seed:e2e
#
# Padrao: MESMO MySQL do Railway em dev e producao.
# Host publico costuma terminar em .proxy.rlwy.net (nao use localhost).
DB_HOST=SEU_HOST.proxy.rlwy.net
DB_PORT=3306
DB_USER=root
DB_PASSWORD=senha_do_railway
DB_NAME=railway
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gere-um-segredo-forte-aqui
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
